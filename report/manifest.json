{
  "manifest_version": 3,
  "name": "JBFC Match Data Auto-Extractor",
  "version": "1.0",
  "description": "Automatically extracts K-League data and sends it to the JBFC Dashboard.",
  "permissions": ["activeTab", "scripting", "tabs"],
  "host_permissions": [
    "*://*.kleague.com/*",
    "*://*.github.io/*"
  ],
  "action": {
    "default_title": "전북현대 매치 리포트 자동 생성",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
