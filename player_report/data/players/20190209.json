ists":2},"total_apps":17,"total_goals":3,"total_assists":2}],"teams":[{"team":"안산","k1":{"apps":null,"goals":null,"assists":null},"k2":{"apps":24,"goals":9,"assists":1},"po":{"apps":null,"goals":null,"assists":null},"cup":{"apps":null,"goals":null,"assists":null},"super_cup":{"apps":null,"goals":null,"assists":null},"total":{"apps":24,"goals":9,"assists":1},"total_apps":24,"total_goals":9,"total_assists":1},{"team":"수원FC","k1":{"apps":null,"goals":null,"assists":null},"k2":{"apps":26,"goals":10,"assists":4},"po":{"apps":1,"goals":0,"assists":0},"cup":{"apps":null,"goals":null,"assists":null},"super_cup":{"apps":null,"goals":null,"assists":null},"total":{"apps":27,"goals":10,"assists":4},"total_apps":27,"total_goals":10,"total_assists":4},{"team":"강원","k1":{"apps":9,"goals":0,"assists":0},"k2":{"apps":null,"goals":null,"assists":null},"po":{"apps":null,"goals":null,"assists":null},"cup":{"apps":null,"goals":null,"assists":null},"super_cup":{"apps":null,"goals":null,"assists":null},"total":{"apps":9,"goals":0,"assists":0},"total_apps":9,"total_goals":0,"total_assists":0},{"team":"대전","k1":{"apps":80,"goals":21,"assists":12},"k2":{"apps":46,"goals":19,"assists":5},"po":{"apps":5,"goals":0,"assists":2},"cup":{"apps":null,"goals":null,"assists":null},"super_cup":{"apps":1,"goals":0,"assists":0},"total":{"apps":132,"goals":40,"assists":19},"total_apps":132,"total_goals":40,"total_assists":19}],"source":"K LEAGUE official playerDetail","fetched_at":"2026-08-28T00:11:03.143197+00:00","scout":{"profile":"마사은(는) 대전 소속 미드필더다. 국적 일본, 31세, 등번호 7번. 신체는 180cm, 78kg. 통산 출장 192경기, 득점 59, 도움 24 (경기당 득점 0.31). 공식 시즌 행은 9개이고, K리그1 89경기, K리그2 96경기. 거쳐 온 구단은 안산, 수원FC, 강원, 그리고 대전이다. 2026시즌 대전에서 17경기 출장, 3골 2도움이다. 아래 장단점은 트랜스퍼마크 식 가십이 아니라, K리그 공식 출장·득점·실점 표와 포지션·신체 스펙을 겹쳐 읽은 스카우팅이다. 출장이 적은 선수는 잠재와 역할 추정 비중이 크고, 출장이 많은 선수는 반복된 숫자로 이야기한다.","strengths":"마사은(는) 대전 중원에서 공식 192경기를 뛰었다. 미드필더는 골보다 ‘경기가 그 선수를 지나가는가’가 먼저다. 득점 59, 도움 24면 박스 근처에서 끝내는 유형이다. 8번·10번·윙 롤 어느 쪽이든 공격 숫자가 따라오는 자원이다. 출장이 많다는 것은 감독이 중원 밸런스를 그 선수에게 맡긴 적이 있다는 뜻이다. 체력과 전술 이해 없이는 어려운 숫자다. 강점을 한 줄로 줄이면 ‘공의 속도를 자신이 정하는가’다. 탈압박이 되면 팀이 한 줄 올라가고, 전환 패스가 되면 윙이 편해진다. 나이가 젊으면 활동량, 많으면 템포 조절이 무기다. 양발을 쓰지 못해도 몸 방향만 빠르면 중원에서 산다.","weaknesses":"마사의 약점은 중원 선수에게 반복되는 세 가지, 압박 아래 볼 손실, 수비 전환 지연, 박스 안 결정력이다. 약한 발, 등 뒤 공간, 파울로 끊는 습관이 약점 리스트의 단골이다. 공격적으로 올라간 뒤 복귀가 늦으면 풀백이 2대1에 당한다. 세트피스 수비 가담이 애매하면 키가 큰 상대의 타깃이 된다. 숫자를 안 만드는 중원일수록, 실수는 눈에 더 크게 남는다."}}