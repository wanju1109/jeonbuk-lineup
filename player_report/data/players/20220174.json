goals":1,"assists":0},"total_apps":12,"total_goals":1,"total_assists":0},{"season":"2025","team":"부산","k1":{"apps":null,"goals":null,"assists":null},"k2":{"apps":36,"goals":1,"assists":0},"po":{"apps":null,"goals":null,"assists":null},"cup":{"apps":null,"goals":null,"assists":null},"super_cup":{"apps":null,"goals":null,"assists":null},"total":{"apps":36,"goals":1,"assists":0},"total_apps":36,"total_goals":1,"total_assists":0},{"season":"2026","team":"전북","k1":{"apps":21,"goals":2,"assists":0},"k2":{"apps":null,"goals":null,"assists":null},"po":{"apps":null,"goals":null,"assists":null},"cup":{"apps":null,"goals":null,"assists":null},"super_cup":{"apps":null,"goals":null,"assists":null},"total":{"apps":21,"goals":2,"assists":0},"total_apps":21,"total_goals":2,"total_assists":0}],"teams":[{"team":"부산","k1":{"apps":null,"goals":null,"assists":null},"k2":{"apps":104,"goals":3,"assists":0},"po":{"apps":2,"goals":0,"assists":0},"cup":{"apps":null,"goals":null,"assists":null},"super_cup":{"apps":null,"goals":null,"assists":null},"total":{"apps":106,"goals":3,"assists":0},"total_apps":106,"total_goals":3,"total_assists":0},{"team":"전북","k1":{"apps":21,"goals":2,"assists":0},"k2":{"apps":null,"goals":null,"assists":null},"po":{"apps":null,"goals":null,"assists":null},"cup":{"apps":null,"goals":null,"assists":null},"super_cup":{"apps":null,"goals":null,"assists":null},"total":{"apps":21,"goals":2,"assists":0},"total_apps":21,"total_goals":2,"total_assists":0}],"source":"K LEAGUE official playerDetail","fetched_at":"2026-08-28T00:11:57.385514+00:00","scout":{"profile":"조위제은(는) 전북 소속 수비수다. 국적 한국, 25세, 등번호 4번. 신체는 189cm, 82kg. 통산 출장 127경기, 득점 5, 도움 0 (경기당 득점 0.04). 공식 시즌 행은 5개이고, K리그1 21경기, K리그2 104경기. 거쳐 온 구단은 부산, 전북이다. 2026시즌 전북에서 21경기 출장, 2골 0도움이다. 아래 장단점은 트랜스퍼마크 식 가십이 아니라, K리그 공식 출장·득점·실점 표와 포지션·신체 스펙을 겹쳐 읽은 스카우팅이다. 출장이 적은 선수는 잠재와 역할 추정 비중이 크고, 출장이 많은 선수는 반복된 숫자로 이야기한다.","strengths":"조위제은(는) 전북 수비 블록의 한 조각으로 공식 출장 127경기를 쌓았다. 수비수는 하이라이트보다 실수하지 않는 반복이 가치다. 189cm면 세트피스 공격·수비 모두에서 1순위 타깃이 된다. 공식 득점 5은 코너와 프리킥 상황에서 이미 골 결정력을 보여 줬다는 뜻이다. 100경기 이상이면 리그 환경(잔디, 심판 기준, 원정)에 몸이 적응된 상태다. 신인 실수형 수비수와는 다른 안정 구간에 있다. 수비수의 진짜 강점은 경합에서 파울을 최소화하면서 턴을 이긴 뒤, 첫 패스를 안전한 쪽으로 연결하는 것이다. 나이가 젊으면 만회 속도, 많으면 위치 선정이 무기가 된다. 팀 수비 원칙(라인 높이)과 맞을 때 개인 능력 이상으로 좋아 보인다.","weaknesses":"조위제의 약점은 수비수에게 공통인 ‘공간’과 ‘스피드 매치업’에서 드러난다. 라인 뒤 침투, 측면 2대1, 세트피스 반대쪽 세컨볼이다. 큰 센터백은 발 빠른 세컨 스트라이커와의 등 뒤 경합에서 불리해질 수 있다. 라인 컨트롤이 흔들리면 만회 스프린트가 길어진다. 빌드업 실수는 곧 결정적 찬스로 이어진다. 약한 발 쪽 압박, 백패스 각, 오프사이드 트랩 타이밍이 상대 스카우팅의 1페이지다. 공격 가담이 많을수록 자리 비움이 약점이 된다. 파울 위치(박스 근처)는 카드와 키커를 동시에 내준다."}}