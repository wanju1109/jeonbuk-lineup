_sheets":null},"super_cup":{"apps":null,"goals_conceded":null,"clean_sheets":null},"total":{"apps":null,"goals_conceded":null,"clean_sheets":null},"total_apps":null,"total_gc":null,"total_cs":null}],"teams":[{"team":"수원","k1":{"apps":135,"goals_conceded":182,"clean_sheets":29},"k2":{"apps":57,"goals_conceded":59,"clean_sheets":15},"po":{"apps":2,"goals_conceded":1,"clean_sheets":1},"cup":{"apps":null,"goals_conceded":null,"clean_sheets":null},"super_cup":{"apps":null,"goals_conceded":null,"clean_sheets":null},"total":{"apps":194,"goals_conceded":242,"clean_sheets":45},"total_apps":194,"total_gc":242,"total_cs":45},{"team":"아산","k1":{"apps":null,"goals_conceded":null,"clean_sheets":null},"k2":{"apps":11,"goals_conceded":16,"clean_sheets":4},"po":{"apps":null,"goals_conceded":null,"clean_sheets":null},"cup":{"apps":null,"goals_conceded":null,"clean_sheets":null},"super_cup":{"apps":null,"goals_conceded":null,"clean_sheets":null},"total":{"apps":11,"goals_conceded":16,"clean_sheets":4},"total_apps":11,"total_gc":16,"total_cs":4}],"source":"K LEAGUE official playerDetail","fetched_at":"2026-09-03T18:20:00.776803+00:00","scout":{"profile":"양형모은(는) 수원 소속 골키퍼다. 국적 한국, 35세, 등번호 21번. 신체는 185cm, 84kg. 통산 출장 205경기, 실점 258, 클린시트 45 (클린시트 비율 22%). 공식 시즌 행은 12개이고, K리그1 135경기, K리그2 68경기. 거쳐 온 구단은 수원, 아산이다. 2026시즌 수원에서 0경기 출장, 실점 0, 클린시트 0다. 아래 장단점은 트랜스퍼마크 식 가십이 아니라, K리그 공식 출장·득점·실점 표와 포지션·신체 스펙을 겹쳐 읽은 스카우팅이다. 출장이 적은 선수는 잠재와 역할 추정 비중이 크고, 출장이 많은 선수는 반복된 숫자로 이야기한다.","strengths":"양형모의 강점은 골문이라는 한 자리를 시즌 단위로 반복해 지킨다는 데 있다. 수원 골키퍼로 등록된 상태에서 공식 출장이 205경기다. 185cm는 현대 골키퍼 평균보다 크지 않을 수 있다. 대신 낮은 슈팅과 리액션, 각 줄이기에 몸을 더 쓰는 쪽으로 강점을 쌓았을 가능성이 크다. 클린시트 45는 단순히 ‘선방을 잘한다’는 말이 아니라, 수비 조직과 맞춰 무실점 경기를 반복했다는 뜻이다. 주전 키퍼의 신뢰 구간에 들어간다. 35세 키퍼는 반사보다 위치 선정과 경기 운영이 무기인 경우가 많다. 젊은 센터백을 소리로 붙잡는 역할이 커진다. 킥으로 빌드업에 가담할 수 있으면 수비 라인이 한 줄 높아져도 경기가 돌아간다. 반대 케이스라도, 펀칭 타이밍과 1대1 각 줄이기만 안정적이면 1순위 경쟁에서 쉽게 밀리지 않는다. 실점 후 다음 액션을 리셋하는 속도는 숫자 뒤에 숨은 강점이다.","weaknesses":"양형모을(를) 공략하는 포인트는 골키퍼 공통의 약점에서 출발한다. 높은 라인, 강한 전방 압박, 박스 밖 낮은 굴절 슈팅이다. 출장 대비 실점(258/205)이 높은 편이면, 개인 선방만의 문제가 아니라 라인 높이·풀백 간격·세트피스 수비와 같이 봐야 한다. 키퍼만 탓하면 오진이다. 고령 키퍼는 리액션보다 선위치가 중요하다. 스피드 있는 침투에 각이 열리면 만회가 어렵다. 백업 운용과 컵대회 분배가 필요하다. 발밑이 흔들리면 상대는 골키퍼를 압박의 트리거로 쓴다. 펀칭 후 세컨볼, 박스 밖 캐치 미스가 약점이 되기 쉽다. 크로스 판단이 과감할수록 빈 골문 리스크도 같이 커진다. 약점은 ‘못 막는다’가 아니라, 상대가 어디에 공을 떨어뜨릴지 아는 것이다."}}