ists":0},"total_apps":1,"total_goals":0,"total_assists":0}],"teams":[{"team":"서울","k1":{"apps":27,"goals":0,"assists":0},"k2":{"apps":null,"goals":null,"assists":null},"po":{"apps":null,"goals":null,"assists":null},"cup":{"apps":null,"goals":null,"assists":null},"super_cup":{"apps":null,"goals":null,"assists":null},"total":{"apps":27,"goals":0,"assists":0},"total_apps":27,"total_goals":0,"total_assists":0},{"team":"전남","k1":{"apps":null,"goals":null,"assists":null},"k2":{"apps":53,"goals":3,"assists":0},"po":{"apps":1,"goals":0,"assists":0},"cup":{"apps":null,"goals":null,"assists":null},"super_cup":{"apps":null,"goals":null,"assists":null},"total":{"apps":54,"goals":3,"assists":0},"total_apps":54,"total_goals":3,"total_assists":0},{"team":"안양","k1":{"apps":null,"goals":null,"assists":null},"k2":{"apps":63,"goals":1,"assists":2},"po":{"apps":3,"goals":0,"assists":0},"cup":{"apps":null,"goals":null,"assists":null},"super_cup":{"apps":null,"goals":null,"assists":null},"total":{"apps":66,"goals":1,"assists":2},"total_apps":66,"total_goals":1,"total_assists":2},{"team":"충남아산","k1":{"apps":null,"goals":null,"assists":null},"k2":{"apps":34,"goals":2,"assists":1},"po":{"apps":2,"goals":0,"assists":0},"cup":{"apps":null,"goals":null,"assists":null},"super_cup":{"apps":null,"goals":null,"assists":null},"total":{"apps":36,"goals":2,"assists":1},"total_apps":36,"total_goals":2,"total_assists":1}],"source":"K LEAGUE official playerDetail","fetched_at":"2026-11-14T19:43:15.643169+00:00","scout":{"profile":"황기욱은(는) 충남아산 소속 미드필더다. 국적 한국, 30세, 등번호 4번. 신체는 185cm, 78kg. 통산 출장 183경기, 득점 6, 도움 3 (경기당 득점 0.03). 공식 시즌 행은 9개이고, K리그1 27경기, K리그2 150경기. 거쳐 온 구단은 서울, 전남, 안양, 그리고 충남아산이다. 2026시즌 충남아산에서 1경기 출장, 0골 0도움이다. 아래 장단점은 트랜스퍼마크 식 가십이 아니라, K리그 공식 출장·득점·실점 표와 포지션·신체 스펙을 겹쳐 읽은 스카우팅이다. 출장이 적은 선수는 잠재와 역할 추정 비중이 크고, 출장이 많은 선수는 반복된 숫자로 이야기한다.","strengths":"황기욱은(는) 충남아산 중원에서 공식 183경기를 뛰었다. 미드필더는 골보다 ‘경기가 그 선수를 지나가는가’가 먼저다. 공격 포인트 9는 순수 6번만은 아니라는 뜻이다. 박스 진입이나 키패스가 이미 기록으로 남았다. 출장이 많다는 것은 감독이 중원 밸런스를 그 선수에게 맡긴 적이 있다는 뜻이다. 체력과 전술 이해 없이는 어려운 숫자다. 185cm 중원은 세컨볼과 세트피스에서 가산점이 있다. 수비형으로 쓰면 스크린, 공격형으로 쓰면 침투 타깃이 된다. 강점을 한 줄로 줄이면 ‘공의 속도를 자신이 정하는가’다. 탈압박이 되면 팀이 한 줄 올라가고, 전환 패스가 되면 윙이 편해진다. 나이가 젊으면 활동량, 많으면 템포 조절이 무기다. 양발을 쓰지 못해도 몸 방향만 빠르면 중원에서 산다.","weaknesses":"황기욱의 약점은 중원 선수에게 반복되는 세 가지, 압박 아래 볼 손실, 수비 전환 지연, 박스 안 결정력이다. 약한 발, 등 뒤 공간, 파울로 끊는 습관이 약점 리스트의 단골이다. 공격적으로 올라간 뒤 복귀가 늦으면 풀백이 2대1에 당한다. 세트피스 수비 가담이 애매하면 키가 큰 상대의 타깃이 된다. 숫자를 안 만드는 중원일수록, 실수는 눈에 더 크게 남는다."}}