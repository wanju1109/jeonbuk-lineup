total_gc":3,"total_cs":0}],"teams":[{"team":"대전","k1":{"apps":22,"goals_conceded":41,"clean_sheets":3},"k2":{"apps":76,"goals_conceded":83,"clean_sheets":23},"po":{"apps":null,"goals_conceded":null,"clean_sheets":null},"cup":{"apps":null,"goals_conceded":null,"clean_sheets":null},"super_cup":{"apps":null,"goals_conceded":null,"clean_sheets":null},"total":{"apps":98,"goals_conceded":124,"clean_sheets":26},"total_apps":98,"total_gc":124,"total_cs":26},{"team":"아산","k1":{"apps":null,"goals_conceded":null,"clean_sheets":null},"k2":{"apps":14,"goals_conceded":12,"clean_sheets":6},"po":{"apps":null,"goals_conceded":null,"clean_sheets":null},"cup":{"apps":null,"goals_conceded":null,"clean_sheets":null},"super_cup":{"apps":null,"goals_conceded":null,"clean_sheets":null},"total":{"apps":14,"goals_conceded":12,"clean_sheets":6},"total_apps":14,"total_gc":12,"total_cs":6},{"team":"충남아산","k1":{"apps":null,"goals_conceded":null,"clean_sheets":null},"k2":{"apps":42,"goals_conceded":46,"clean_sheets":14},"po":{"apps":null,"goals_conceded":null,"clean_sheets":null},"cup":{"apps":null,"goals_conceded":null,"clean_sheets":null},"super_cup":{"apps":null,"goals_conceded":null,"clean_sheets":null},"total":{"apps":42,"goals_conceded":46,"clean_sheets":14},"total_apps":42,"total_gc":46,"total_cs":14},{"team":"전남","k1":{"apps":null,"goals_conceded":null,"clean_sheets":null},"k2":{"apps":null,"goals_conceded":null,"clean_sheets":null},"po":{"apps":null,"goals_conceded":null,"clean_sheets":null},"cup":{"apps":null,"goals_conceded":null,"clean_sheets":null},"super_cup":{"apps":null,"goals_conceded":null,"clean_sheets":null},"total":{"apps":null,"goals_conceded":null,"clean_sheets":null},"total_apps":null,"total_gc":null,"total_cs":null},{"team":"천안","k1":{"apps":null,"goals_conceded":null,"clean_sheets":null},"k2":{"apps":29,"goals_conceded":47,"clean_sheets":4},"po":{"apps":null,"goals_conceded":null,"clean_sheets":null},"cup":{"apps":null,"goals_conceded":null,"clean_sheets":null},"super_cup":{"apps":null,"goals_conceded":null,"clean_sheets":null},"total":{"apps":29,"goals_conceded":47,"clean_sheets":4},"total_apps":29,"total_gc":47,"total_cs":4}],"source":"K LEAGUE official playerDetail","fetched_at":"2026-08-30T18:21:34.018786+00:00","scout":{"profile":"박주원은(는) 천안 소속 골키퍼다. 국적 한국, 35세, 등번호 1번. 신체는 192cm, 81kg. 통산 출장 183경기, 실점 229, 클린시트 26 (클린시트 비율 14%). 공식 시즌 행은 16개이고, K리그1 22경기, K리그2 161경기. 거쳐 온 구단은 대전, 아산, 충남아산, 전남, 그리고 천안이다. 2026시즌 천안에서 3경기 출장, 실점 3, 클린시트 0다. 아래 장단점은 트랜스퍼마크 식 가십이 아니라, K리그 공식 출장·득점·실점 표와 포지션·신체 스펙을 겹쳐 읽은 스카우팅이다. 출장이 적은 선수는 잠재와 역할 추정 비중이 크고, 출장이 많은 선수는 반복된 숫자로 이야기한다.","strengths":"박주원의 강점은 골문이라는 한 자리를 시즌 단위로 반복해 지킨다는 데 있다. 천안 골키퍼로 등록된 상태에서 공식 출장이 183경기다. 192cm의 키는 세트피스와 박스 안 공중볼에서 펀칭·캐치의 도달 범위를 넓힌다. 상대가 크로스를 올릴 때 수비수가 뒤로 물러나지 않아도 되는 타입이다. 클린시트 26는 단순히 ‘선방을 잘한다’는 말이 아니라, 수비 조직과 맞춰 무실점 경기를 반복했다는 뜻이다. 주전 키퍼의 신뢰 구간에 들어간다. 35세 키퍼는 반사보다 위치 선정과 경기 운영이 무기인 경우가 많다. 젊은 센터백을 소리로 붙잡는 역할이 커진다. 킥으로 빌드업에 가담할 수 있으면 수비 라인이 한 줄 높아져도 경기가 돌아간다. 반대 케이스라도, 펀칭 타이밍과 1대1 각 줄이기만 안정적이면 1순위 경쟁에서 쉽게 밀리지 않는다. 실점 후 다음 액션을 리셋하는 속도는 숫자 뒤에 숨은 강점이다.","weaknesses":"박주원을(를) 공략하는 포인트는 골키퍼 공통의 약점에서 출발한다. 높은 라인, 강한 전방 압박, 박스 밖 낮은 굴절 슈팅이다. 큰 키는 공중볼의 무기인 동시에, 낮은 근거리 슈팅에서 몸을 접는 동작이 한 박자 늦어 보일 수 있다. 컷백 이후 원터치 슈팅이 위험 구간이다. 출장 대비 실점(229/183)이 높은 편이면, 개인 선방만의 문제가 아니라 라인 높이·풀백 간격·세트피스 수비와 같이 봐야 한다. 키퍼만 탓하면 오진이다. 고령 키퍼는 리액션보다 선위치가 중요하다. 스피드 있는 침투에 각이 열리면 만회가 어렵다. 백업 운용과 컵대회 분배가 필요하다. 발밑이 흔들리면 상대는 골키퍼를 압박의 트리거로 쓴다. 펀칭 후 세컨볼, 박스 밖 캐치 미스가 약점이 되기 쉽다. 크로스 판단이 과감할수록 빈 골문 리스크도 같이 커진다. 약점은 ‘못 막는다’가 아니라, 상대가 어디에 공을 떨어뜨릴지 아는 것이다."}}