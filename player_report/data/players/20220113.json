:null,"assists":null},"k2":{"apps":31,"goals":2,"assists":0},"po":{"apps":null,"goals":null,"assists":null},"cup":{"apps":null,"goals":null,"assists":null},"super_cup":{"apps":null,"goals":null,"assists":null},"total":{"apps":31,"goals":2,"assists":0},"total_apps":31,"total_goals":2,"total_assists":0},{"season":"2026","team":"인천","k1":{"apps":11,"goals":0,"assists":1},"k2":{"apps":null,"goals":null,"assists":null},"po":{"apps":null,"goals":null,"assists":null},"cup":{"apps":null,"goals":null,"assists":null},"super_cup":{"apps":null,"goals":null,"assists":null},"total":{"apps":11,"goals":0,"assists":1},"total_apps":11,"total_goals":0,"total_assists":1}],"teams":[{"team":"인천","k1":{"apps":49,"goals":2,"assists":1},"k2":{"apps":31,"goals":2,"assists":0},"po":{"apps":null,"goals":null,"assists":null},"cup":{"apps":null,"goals":null,"assists":null},"super_cup":{"apps":null,"goals":null,"assists":null},"total":{"apps":80,"goals":4,"assists":1},"total_apps":80,"total_goals":4,"total_assists":1},{"team":"김포","k1":{"apps":null,"goals":null,"assists":null},"k2":{"apps":31,"goals":1,"assists":2},"po":{"apps":3,"goals":0,"assists":0},"cup":{"apps":null,"goals":null,"assists":null},"super_cup":{"apps":null,"goals":null,"assists":null},"total":{"apps":34,"goals":1,"assists":2},"total_apps":34,"total_goals":1,"total_assists":2}],"source":"K LEAGUE official playerDetail","fetched_at":"2026-08-28T00:11:42.891741+00:00","scout":{"profile":"김성민은(는) 인천 소속 수비수다. 국적 한국, 26세, 등번호 17번. 신체는 171cm, 69kg. 통산 출장 114경기, 득점 5, 도움 3 (경기당 득점 0.04). 공식 시즌 행은 5개이고, K리그1 49경기, K리그2 62경기. 거쳐 온 구단은 인천, 김포이다. 2026시즌 인천에서 11경기 출장, 0골 1도움이다. 아래 장단점은 트랜스퍼마크 식 가십이 아니라, K리그 공식 출장·득점·실점 표와 포지션·신체 스펙을 겹쳐 읽은 스카우팅이다. 출장이 적은 선수는 잠재와 역할 추정 비중이 크고, 출장이 많은 선수는 반복된 숫자로 이야기한다.","strengths":"김성민은(는) 인천 수비 블록의 한 조각으로 공식 출장 114경기를 쌓았다. 수비수는 하이라이트보다 실수하지 않는 반복이 가치다. 171cm는 센터백보다 풀백·윙백 체형에 가깝다. 오버랩과 1대1 수비가 강점 후보가 되고, 도움 {assists}가 그 힌트다. 100경기 이상이면 리그 환경(잔디, 심판 기준, 원정)에 몸이 적응된 상태다. 신인 실수형 수비수와는 다른 안정 구간에 있다. 도움 3는 수비수치고 공격 가담이 있다는 신호다. 오버랩이나 롱 패스로 전진에 가담하는 유형으로 읽힌다. 수비수의 진짜 강점은 경합에서 파울을 최소화하면서 턴을 이긴 뒤, 첫 패스를 안전한 쪽으로 연결하는 것이다. 나이가 젊으면 만회 속도, 많으면 위치 선정이 무기가 된다. 팀 수비 원칙(라인 높이)과 맞을 때 개인 능력 이상으로 좋아 보인다.","weaknesses":"김성민의 약점은 수비수에게 공통인 ‘공간’과 ‘스피드 매치업’에서 드러난다. 라인 뒤 침투, 측면 2대1, 세트피스 반대쪽 세컨볼이다. 작은 키 수비수는 페널티박스 혼전과 상대 타깃맨 매치업에서 제공권 부담이 있다. 옆 센터백·골키퍼와의 커버 약속이 필수다. 빌드업 실수는 곧 결정적 찬스로 이어진다. 약한 발 쪽 압박, 백패스 각, 오프사이드 트랩 타이밍이 상대 스카우팅의 1페이지다. 공격 가담이 많을수록 자리 비움이 약점이 된다. 파울 위치(박스 근처)는 카드와 키커를 동시에 내준다."}}