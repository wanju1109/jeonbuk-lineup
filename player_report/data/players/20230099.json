als":0,"assists":0},"k2":{"apps":null,"goals":null,"assists":null},"po":{"apps":null,"goals":null,"assists":null},"cup":{"apps":null,"goals":null,"assists":null},"super_cup":{"apps":null,"goals":null,"assists":null},"total":{"apps":7,"goals":0,"assists":0},"total_apps":7,"total_goals":0,"total_assists":0}],"teams":[{"team":"수원","k1":{"apps":null,"goals":null,"assists":null},"k2":{"apps":24,"goals":0,"assists":0},"po":{"apps":2,"goals":0,"assists":0},"cup":{"apps":null,"goals":null,"assists":null},"super_cup":{"apps":null,"goals":null,"assists":null},"total":{"apps":26,"goals":0,"assists":0},"total_apps":26,"total_goals":0,"total_assists":0},{"team":"광주","k1":{"apps":7,"goals":0,"assists":0},"k2":{"apps":null,"goals":null,"assists":null},"po":{"apps":null,"goals":null,"assists":null},"cup":{"apps":null,"goals":null,"assists":null},"super_cup":{"apps":null,"goals":null,"assists":null},"total":{"apps":7,"goals":0,"assists":0},"total_apps":7,"total_goals":0,"total_assists":0}],"source":"K LEAGUE official playerDetail","fetched_at":"2026-09-02T18:15:10.158288+00:00","scout":{"profile":"장석환은(는) 광주 소속 수비수다. 국적 한국, 21세, 등번호 2번. 신체는 180cm, 70kg. 통산 출장 33경기, 득점 0, 도움 0 (경기당 득점 0.00). 공식 시즌 행은 4개이고, K리그1 7경기, K리그2 24경기. 거쳐 온 구단은 수원, 광주이다. 2026시즌 광주에서 7경기 출장, 0골 0도움이다. 아래 장단점은 트랜스퍼마크 식 가십이 아니라, K리그 공식 출장·득점·실점 표와 포지션·신체 스펙을 겹쳐 읽은 스카우팅이다. 출장이 적은 선수는 잠재와 역할 추정 비중이 크고, 출장이 많은 선수는 반복된 숫자로 이야기한다.","strengths":"장석환은(는) 광주 수비 블록의 한 조각으로 공식 출장 33경기를 쌓았다. 수비수는 하이라이트보다 실수하지 않는 반복이 가치다. 주전 로테이션에 들어갔다는 출장이다. 감독이 특정 매치업에서 빼지 않을 정도의 신뢰는 이미 있다. 수비수의 진짜 강점은 경합에서 파울을 최소화하면서 턴을 이긴 뒤, 첫 패스를 안전한 쪽으로 연결하는 것이다. 나이가 젊으면 만회 속도, 많으면 위치 선정이 무기가 된다. 팀 수비 원칙(라인 높이)과 맞을 때 개인 능력 이상으로 좋아 보인다.","weaknesses":"장석환의 약점은 수비수에게 공통인 ‘공간’과 ‘스피드 매치업’에서 드러난다. 라인 뒤 침투, 측면 2대1, 세트피스 반대쪽 세컨볼이다. 빌드업 실수는 곧 결정적 찬스로 이어진다. 약한 발 쪽 압박, 백패스 각, 오프사이드 트랩 타이밍이 상대 스카우팅의 1페이지다. 공격 가담이 많을수록 자리 비움이 약점이 된다. 파울 위치(박스 근처)는 카드와 키커를 동시에 내준다."}}