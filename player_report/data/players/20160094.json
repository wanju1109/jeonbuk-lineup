s":31,"goals":3,"assists":1},"total_apps":31,"total_goals":3,"total_assists":1},{"season":"2026","team":"인천","k1":{"apps":16,"goals":0,"assists":1},"k2":{"apps":null,"goals":null,"assists":null},"po":{"apps":null,"goals":null,"assists":null},"cup":{"apps":null,"goals":null,"assists":null},"super_cup":{"apps":null,"goals":null,"assists":null},"total":{"apps":16,"goals":0,"assists":1},"total_apps":16,"total_goals":0,"total_assists":1}],"teams":[{"team":"대구","k1":{"apps":98,"goals":8,"assists":5},"k2":{"apps":null,"goals":null,"assists":null},"po":{"apps":2,"goals":0,"assists":0},"cup":{"apps":null,"goals":null,"assists":null},"super_cup":{"apps":null,"goals":null,"assists":null},"total":{"apps":100,"goals":8,"assists":5},"total_apps":100,"total_goals":8,"total_assists":5},{"team":"김천","k1":{"apps":15,"goals":2,"assists":1},"k2":{"apps":27,"goals":5,"assists":1},"po":{"apps":null,"goals":null,"assists":null},"cup":{"apps":null,"goals":null,"assists":null},"super_cup":{"apps":null,"goals":null,"assists":null},"total":{"apps":42,"goals":7,"assists":2},"total_apps":42,"total_goals":7,"total_assists":2},{"team":"인천","k1":{"apps":16,"goals":0,"assists":1},"k2":{"apps":null,"goals":null,"assists":null},"po":{"apps":null,"goals":null,"assists":null},"cup":{"apps":null,"goals":null,"assists":null},"super_cup":{"apps":null,"goals":null,"assists":null},"total":{"apps":16,"goals":0,"assists":1},"total_apps":16,"total_goals":0,"total_assists":1}],"source":"K LEAGUE official playerDetail","fetched_at":"2026-08-29T18:03:37.155156+00:00","scout":{"profile":"정치인은(는) 인천 소속 미드필더다. 국적 한국, 29세, 등번호 23번. 신체는 182cm, 71kg. 통산 출장 158경기, 득점 15, 도움 8 (경기당 득점 0.09). 공식 시즌 행은 10개이고, K리그1 129경기, K리그2 27경기. 거쳐 온 구단은 대구, 김천, 그리고 인천이다. 2026시즌 인천에서 16경기 출장, 0골 1도움이다. 아래 장단점은 트랜스퍼마크 식 가십이 아니라, K리그 공식 출장·득점·실점 표와 포지션·신체 스펙을 겹쳐 읽은 스카우팅이다. 출장이 적은 선수는 잠재와 역할 추정 비중이 크고, 출장이 많은 선수는 반복된 숫자로 이야기한다.","strengths":"정치인은(는) 인천 중원에서 공식 158경기를 뛰었다. 미드필더는 골보다 ‘경기가 그 선수를 지나가는가’가 먼저다. 득점 15, 도움 8면 박스 근처에서 끝내는 유형이다. 8번·10번·윙 롤 어느 쪽이든 공격 숫자가 따라오는 자원이다. 출장이 많다는 것은 감독이 중원 밸런스를 그 선수에게 맡긴 적이 있다는 뜻이다. 체력과 전술 이해 없이는 어려운 숫자다. 강점을 한 줄로 줄이면 ‘공의 속도를 자신이 정하는가’다. 탈압박이 되면 팀이 한 줄 올라가고, 전환 패스가 되면 윙이 편해진다. 나이가 젊으면 활동량, 많으면 템포 조절이 무기다. 양발을 쓰지 못해도 몸 방향만 빠르면 중원에서 산다.","weaknesses":"정치인의 약점은 중원 선수에게 반복되는 세 가지, 압박 아래 볼 손실, 수비 전환 지연, 박스 안 결정력이다. 약한 발, 등 뒤 공간, 파울로 끊는 습관이 약점 리스트의 단골이다. 공격적으로 올라간 뒤 복귀가 늦으면 풀백이 2대1에 당한다. 세트피스 수비 가담이 애매하면 키가 큰 상대의 타깃이 된다. 숫자를 안 만드는 중원일수록, 실수는 눈에 더 크게 남는다."}}