,"assists":null},"total":{"apps":19,"goals":2,"assists":0},"total_apps":19,"total_goals":2,"total_assists":0},{"season":"2026","team":"안양","k1":{"apps":9,"goals":0,"assists":1},"k2":{"apps":null,"goals":null,"assists":null},"po":{"apps":null,"goals":null,"assists":null},"cup":{"apps":null,"goals":null,"assists":null},"super_cup":{"apps":null,"goals":null,"assists":null},"total":{"apps":9,"goals":0,"assists":1},"total_apps":9,"total_goals":0,"total_assists":1}],"teams":[{"team":"전북","k1":{"apps":126,"goals":17,"assists":24},"k2":{"apps":null,"goals":null,"assists":null},"po":{"apps":null,"goals":null,"assists":null},"cup":{"apps":null,"goals":null,"assists":null},"super_cup":{"apps":null,"goals":null,"assists":null},"total":{"apps":126,"goals":17,"assists":24},"total_apps":126,"total_goals":17,"total_assists":24},{"team":"울산","k1":{"apps":35,"goals":13,"assists":9},"k2":{"apps":null,"goals":null,"assists":null},"po":{"apps":null,"goals":null,"assists":null},"cup":{"apps":null,"goals":null,"assists":null},"super_cup":{"apps":null,"goals":null,"assists":null},"total":{"apps":35,"goals":13,"assists":9},"total_apps":35,"total_goals":13,"total_assists":9},{"team":"수원","k1":{"apps":23,"goals":0,"assists":2},"k2":{"apps":14,"goals":1,"assists":0},"po":{"apps":null,"goals":null,"assists":null},"cup":{"apps":null,"goals":null,"assists":null},"super_cup":{"apps":null,"goals":null,"assists":null},"total":{"apps":37,"goals":1,"assists":2},"total_apps":37,"total_goals":1,"total_assists":2},{"team":"안양","k1":{"apps":28,"goals":2,"assists":1},"k2":{"apps":null,"goals":null,"assists":null},"po":{"apps":null,"goals":null,"assists":null},"cup":{"apps":null,"goals":null,"assists":null},"super_cup":{"apps":null,"goals":null,"assists":null},"total":{"apps":28,"goals":2,"assists":1},"total_apps":28,"total_goals":2,"total_assists":1}],"source":"K LEAGUE official playerDetail","fetched_at":"2026-08-26T03:14:03.750634+00:00","scout":{"profile":"김보경은(는) 안양 소속 미드필더다. 국적 한국, 36세, 등번호 24번. 신체는 176cm, 72kg. 통산 출장 226경기, 득점 33, 도움 36 (경기당 득점 0.15). 공식 시즌 행은 10개이고, K리그1 212경기, K리그2 14경기. 거쳐 온 구단은 전북, 울산, 수원, 그리고 안양이다. 2026시즌 안양에서 9경기 출장, 0골 1도움이다. 아래 장단점은 트랜스퍼마크 식 가십이 아니라, K리그 공식 출장·득점·실점 표와 포지션·신체 스펙을 겹쳐 읽은 스카우팅이다. 출장이 적은 선수는 잠재와 역할 추정 비중이 크고, 출장이 많은 선수는 반복된 숫자로 이야기한다.","strengths":"김보경은(는) 안양 중원에서 공식 226경기를 뛰었다. 미드필더는 골보다 ‘경기가 그 선수를 지나가는가’가 먼저다. 득점 33, 도움 36면 박스 근처에서 끝내는 유형이다. 8번·10번·윙 롤 어느 쪽이든 공격 숫자가 따라오는 자원이다. 출장이 많다는 것은 감독이 중원 밸런스를 그 선수에게 맡긴 적이 있다는 뜻이다. 체력과 전술 이해 없이는 어려운 숫자다. 강점을 한 줄로 줄이면 ‘공의 속도를 자신이 정하는가’다. 탈압박이 되면 팀이 한 줄 올라가고, 전환 패스가 되면 윙이 편해진다. 나이가 젊으면 활동량, 많으면 템포 조절이 무기다. 양발을 쓰지 못해도 몸 방향만 빠르면 중원에서 산다.","weaknesses":"김보경의 약점은 중원 선수에게 반복되는 세 가지, 압박 아래 볼 손실, 수비 전환 지연, 박스 안 결정력이다. 36세 중원은 박스 투 박스 거리를 90분 유지하기 어렵다. 짝을 누구에게 붙이느냐가 경기력이다. 약한 발, 등 뒤 공간, 파울로 끊는 습관이 약점 리스트의 단골이다. 공격적으로 올라간 뒤 복귀가 늦으면 풀백이 2대1에 당한다. 세트피스 수비 가담이 애매하면 키가 큰 상대의 타깃이 된다. 숫자를 안 만드는 중원일수록, 실수는 눈에 더 크게 남는다."}}