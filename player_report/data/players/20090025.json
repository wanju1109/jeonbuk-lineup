als":null,"assists":null},"cup":{"apps":4,"goals":0,"assists":0},"super_cup":{"apps":null,"goals":null,"assists":null},"total":{"apps":105,"goals":4,"assists":2},"total_apps":105,"total_goals":4,"total_assists":2},{"team":"성남","k1":{"apps":38,"goals":2,"assists":1},"k2":{"apps":null,"goals":null,"assists":null},"po":{"apps":null,"goals":null,"assists":null},"cup":{"apps":null,"goals":null,"assists":null},"super_cup":{"apps":null,"goals":null,"assists":null},"total":{"apps":38,"goals":2,"assists":1},"total_apps":38,"total_goals":2,"total_assists":1},{"team":"전남","k1":{"apps":91,"goals":3,"assists":0},"k2":{"apps":null,"goals":null,"assists":null},"po":{"apps":null,"goals":null,"assists":null},"cup":{"apps":null,"goals":null,"assists":null},"super_cup":{"apps":null,"goals":null,"assists":null},"total":{"apps":91,"goals":3,"assists":0},"total_apps":91,"total_goals":3,"total_assists":0},{"team":"전북","k1":{"apps":48,"goals":0,"assists":0},"k2":{"apps":null,"goals":null,"assists":null},"po":{"apps":null,"goals":null,"assists":null},"cup":{"apps":null,"goals":null,"assists":null},"super_cup":{"apps":null,"goals":null,"assists":null},"total":{"apps":48,"goals":0,"assists":0},"total_apps":48,"total_goals":0,"total_assists":0},{"team":"대전","k1":{"apps":15,"goals":0,"assists":1},"k2":{"apps":null,"goals":null,"assists":null},"po":{"apps":null,"goals":null,"assists":null},"cup":{"apps":null,"goals":null,"assists":null},"super_cup":{"apps":null,"goals":null,"assists":null},"total":{"apps":15,"goals":0,"assists":1},"total_apps":15,"total_goals":0,"total_assists":1}],"source":"K LEAGUE official playerDetail","fetched_at":"2026-09-04T17:55:36.189274+00:00","scout":{"profile":"임종은은(는) 대전 소속 수비수다. 국적 한국, 36세, 등번호 5번. 신체는 192cm, 88kg. 통산 출장 297경기, 득점 9, 도움 4 (경기당 득점 0.03). 공식 시즌 행은 14개이고, K리그1 293경기. 거쳐 온 구단은 울산, 성남, 전남, 전북, 그리고 대전이다. 2026시즌 대전에서 2경기 출장, 0골 0도움이다. 아래 장단점은 트랜스퍼마크 식 가십이 아니라, K리그 공식 출장·득점·실점 표와 포지션·신체 스펙을 겹쳐 읽은 스카우팅이다. 출장이 적은 선수는 잠재와 역할 추정 비중이 크고, 출장이 많은 선수는 반복된 숫자로 이야기한다.","strengths":"임종은은(는) 대전 수비 블록의 한 조각으로 공식 출장 297경기를 쌓았다. 수비수는 하이라이트보다 실수하지 않는 반복이 가치다. 192cm면 세트피스 공격·수비 모두에서 1순위 타깃이 된다. 공식 득점 9은 코너와 프리킥 상황에서 이미 골 결정력을 보여 줬다는 뜻이다. 100경기 이상이면 리그 환경(잔디, 심판 기준, 원정)에 몸이 적응된 상태다. 신인 실수형 수비수와는 다른 안정 구간에 있다. 도움 4는 수비수치고 공격 가담이 있다는 신호다. 오버랩이나 롱 패스로 전진에 가담하는 유형으로 읽힌다. 수비수의 진짜 강점은 경합에서 파울을 최소화하면서 턴을 이긴 뒤, 첫 패스를 안전한 쪽으로 연결하는 것이다. 나이가 젊으면 만회 속도, 많으면 위치 선정이 무기가 된다. 팀 수비 원칙(라인 높이)과 맞을 때 개인 능력 이상으로 좋아 보인다.","weaknesses":"임종은의 약점은 수비수에게 공통인 ‘공간’과 ‘스피드 매치업’에서 드러난다. 라인 뒤 침투, 측면 2대1, 세트피스 반대쪽 세컨볼이다. 큰 센터백은 발 빠른 세컨 스트라이커와의 등 뒤 경합에서 불리해질 수 있다. 라인 컨트롤이 흔들리면 만회 스프린트가 길어진다. 36세 수비는 방향 전환과 반복 스프린트에서 젊은 윙과 붙으면 공간이 열린다. 출전 분배와 매치업 선택이 감독의 숙제다. 빌드업 실수는 곧 결정적 찬스로 이어진다. 약한 발 쪽 압박, 백패스 각, 오프사이드 트랩 타이밍이 상대 스카우팅의 1페이지다. 공격 가담이 많을수록 자리 비움이 약점이 된다. 파울 위치(박스 근처)는 카드와 키커를 동시에 내준다."}}