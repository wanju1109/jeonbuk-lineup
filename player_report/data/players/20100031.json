oals_conceded":36,"clean_sheets":15},"total_apps":37,"total_gc":36,"total_cs":15},{"team":"수원","k1":{"apps":7,"goals_conceded":17,"clean_sheets":0},"k2":{"apps":null,"goals_conceded":null,"clean_sheets":null},"po":{"apps":null,"goals_conceded":null,"clean_sheets":null},"cup":{"apps":null,"goals_conceded":null,"clean_sheets":null},"super_cup":{"apps":null,"goals_conceded":null,"clean_sheets":null},"total":{"apps":7,"goals_conceded":17,"clean_sheets":0},"total_apps":7,"total_gc":17,"total_cs":0},{"team":"전남","k1":{"apps":null,"goals_conceded":null,"clean_sheets":null},"k2":{"apps":58,"goals_conceded":69,"clean_sheets":14},"po":{"apps":null,"goals_conceded":null,"clean_sheets":null},"cup":{"apps":null,"goals_conceded":null,"clean_sheets":null},"super_cup":{"apps":null,"goals_conceded":null,"clean_sheets":null},"total":{"apps":58,"goals_conceded":69,"clean_sheets":14},"total_apps":58,"total_gc":69,"total_cs":14},{"team":"안양","k1":{"apps":38,"goals_conceded":46,"clean_sheets":5},"k2":{"apps":35,"goals_conceded":35,"clean_sheets":11},"po":{"apps":null,"goals_conceded":null,"clean_sheets":null},"cup":{"apps":null,"goals_conceded":null,"clean_sheets":null},"super_cup":{"apps":null,"goals_conceded":null,"clean_sheets":null},"total":{"apps":73,"goals_conceded":81,"clean_sheets":16},"total_apps":73,"total_gc":81,"total_cs":16}],"source":"K LEAGUE official playerDetail","fetched_at":"2026-08-31T20:29:57.082333+00:00","scout":{"profile":"김다솔은(는) 안양 소속 골키퍼다. 국적 한국, 37세, 등번호 31번. 신체는 188cm, 80kg. 통산 출장 211경기, 실점 249, 클린시트 9 (클린시트 비율 4%). 공식 시즌 행은 17개이고, K리그1 80경기, K리그2 130경기. 거쳐 온 구단은 포항, 대전, 인천, 수원FC, 수원, 전남, 그리고 안양이다. 2026시즌 안양에서 3경기 출장, 실점 4, 클린시트 0다. 아래 장단점은 트랜스퍼마크 식 가십이 아니라, K리그 공식 출장·득점·실점 표와 포지션·신체 스펙을 겹쳐 읽은 스카우팅이다. 출장이 적은 선수는 잠재와 역할 추정 비중이 크고, 출장이 많은 선수는 반복된 숫자로 이야기한다.","strengths":"김다솔의 강점은 골문이라는 한 자리를 시즌 단위로 반복해 지킨다는 데 있다. 안양 골키퍼로 등록된 상태에서 공식 출장이 211경기다. 188cm는 현대 골키퍼 평균보다 크지 않을 수 있다. 대신 낮은 슈팅과 리액션, 각 줄이기에 몸을 더 쓰는 쪽으로 강점을 쌓았을 가능성이 크다. 출장이 어느 정도 쌓였다면, 감독이 교체 키퍼로만 쓰지 않았다는 신호다. 큰 경기 로테이션과 컵대회에서 이미 검증된 셈이다. 37세 키퍼는 반사보다 위치 선정과 경기 운영이 무기인 경우가 많다. 젊은 센터백을 소리로 붙잡는 역할이 커진다. 킥으로 빌드업에 가담할 수 있으면 수비 라인이 한 줄 높아져도 경기가 돌아간다. 반대 케이스라도, 펀칭 타이밍과 1대1 각 줄이기만 안정적이면 1순위 경쟁에서 쉽게 밀리지 않는다. 실점 후 다음 액션을 리셋하는 속도는 숫자 뒤에 숨은 강점이다.","weaknesses":"김다솔을(를) 공략하는 포인트는 골키퍼 공통의 약점에서 출발한다. 높은 라인, 강한 전방 압박, 박스 밖 낮은 굴절 슈팅이다. 고령 키퍼는 리액션보다 선위치가 중요하다. 스피드 있는 침투에 각이 열리면 만회가 어렵다. 백업 운용과 컵대회 분배가 필요하다. 발밑이 흔들리면 상대는 골키퍼를 압박의 트리거로 쓴다. 펀칭 후 세컨볼, 박스 밖 캐치 미스가 약점이 되기 쉽다. 크로스 판단이 과감할수록 빈 골문 리스크도 같이 커진다. 약점은 ‘못 막는다’가 아니라, 상대가 어디에 공을 떨어뜨릴지 아는 것이다."}}