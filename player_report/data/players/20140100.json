total_gc":35,"total_cs":6},{"season":"2022","team":"인천","k1":{"apps":12,"goals_conceded":18,"clean_sheets":2},"k2":{"apps":null,"goals_conceded":null,"clean_sheets":null},"po":{"apps":null,"goals_conceded":null,"clean_sheets":null},"cup":{"apps":null,"goals_conceded":null,"clean_sheets":null},"super_cup":{"apps":null,"goals_conceded":null,"clean_sheets":null},"total":{"apps":12,"goals_conceded":18,"clean_sheets":2},"total_apps":12,"total_gc":18,"total_cs":2},{"season":"2023","team":"인천","k1":{"apps":9,"goals_conceded":12,"clean_sheets":2},"k2":{"apps":null,"goals_conceded":null,"clean_sheets":null},"po":{"apps":null,"goals_conceded":null,"clean_sheets":null},"cup":{"apps":null,"goals_conceded":null,"clean_sheets":null},"super_cup":{"apps":null,"goals_conceded":null,"clean_sheets":null},"total":{"apps":9,"goals_conceded":12,"clean_sheets":2},"total_apps":9,"total_gc":12,"total_cs":2},{"season":"2026","team":"인천","k1":{"apps":5,"goals_conceded":4,"clean_sheets":1},"k2":{"apps":null,"goals_conceded":null,"clean_sheets":null},"po":{"apps":null,"goals_conceded":null,"clean_sheets":null},"cup":{"apps":null,"goals_conceded":null,"clean_sheets":null},"super_cup":{"apps":null,"goals_conceded":null,"clean_sheets":null},"total":{"apps":5,"goals_conceded":4,"clean_sheets":1},"total_apps":5,"total_gc":4,"total_cs":1}],"teams":[{"team":"인천","k1":{"apps":105,"goals_conceded":137,"clean_sheets":29},"k2":{"apps":null,"goals_conceded":null,"clean_sheets":null},"po":{"apps":null,"goals_conceded":null,"clean_sheets":null},"cup":{"apps":null,"goals_conceded":null,"clean_sheets":null},"super_cup":{"apps":null,"goals_conceded":null,"clean_sheets":null},"total":{"apps":105,"goals_conceded":137,"clean_sheets":29},"total_apps":105,"total_gc":137,"total_cs":29}],"source":"K LEAGUE official playerDetail","fetched_at":"2026-08-26T05:47:51.458873+00:00","scout":{"profile":"이태희은(는) 인천 소속 골키퍼다. 국적 한국, 31세, 등번호 21번. 신체는 189cm, 84kg. 통산 출장 105경기, 실점 137, 클린시트 29 (클린시트 비율 28%). 공식 시즌 행은 10개이고, K리그1 105경기. 공식 팀별 기록은 인천 한 곳으로 모여 있다. 원클럽에 가깝다. 2026시즌 인천에서 5경기 출장, 실점 4, 클린시트 1다. 아래 장단점은 트랜스퍼마크 식 가십이 아니라, K리그 공식 출장·득점·실점 표와 포지션·신체 스펙을 겹쳐 읽은 스카우팅이다. 출장이 적은 선수는 잠재와 역할 추정 비중이 크고, 출장이 많은 선수는 반복된 숫자로 이야기한다.","strengths":"이태희의 강점은 골문이라는 한 자리를 시즌 단위로 반복해 지킨다는 데 있다. 인천 골키퍼로 등록된 상태에서 공식 출장이 105경기다. 189cm는 현대 골키퍼 평균보다 크지 않을 수 있다. 대신 낮은 슈팅과 리액션, 각 줄이기에 몸을 더 쓰는 쪽으로 강점을 쌓았을 가능성이 크다. 클린시트 29는 단순히 ‘선방을 잘한다’는 말이 아니라, 수비 조직과 맞춰 무실점 경기를 반복했다는 뜻이다. 주전 키퍼의 신뢰 구간에 들어간다. 킥으로 빌드업에 가담할 수 있으면 수비 라인이 한 줄 높아져도 경기가 돌아간다. 반대 케이스라도, 펀칭 타이밍과 1대1 각 줄이기만 안정적이면 1순위 경쟁에서 쉽게 밀리지 않는다. 실점 후 다음 액션을 리셋하는 속도는 숫자 뒤에 숨은 강점이다.","weaknesses":"이태희을(를) 공략하는 포인트는 골키퍼 공통의 약점에서 출발한다. 높은 라인, 강한 전방 압박, 박스 밖 낮은 굴절 슈팅이다. 출장 대비 실점(137/105)이 높은 편이면, 개인 선방만의 문제가 아니라 라인 높이·풀백 간격·세트피스 수비와 같이 봐야 한다. 키퍼만 탓하면 오진이다. 발밑이 흔들리면 상대는 골키퍼를 압박의 트리거로 쓴다. 펀칭 후 세컨볼, 박스 밖 캐치 미스가 약점이 되기 쉽다. 크로스 판단이 과감할수록 빈 골문 리스크도 같이 커진다. 약점은 ‘못 막는다’가 아니라, 상대가 어디에 공을 떨어뜨릴지 아는 것이다."}}