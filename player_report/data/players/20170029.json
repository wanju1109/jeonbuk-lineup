oals_conceded":5,"clean_sheets":2},"total_apps":5,"total_gc":5,"total_cs":2},{"season":"2026","team":"울산","k1":{"apps":null,"goals_conceded":null,"clean_sheets":null},"k2":{"apps":null,"goals_conceded":null,"clean_sheets":null},"po":{"apps":null,"goals_conceded":null,"clean_sheets":null},"cup":{"apps":null,"goals_conceded":null,"clean_sheets":null},"super_cup":{"apps":null,"goals_conceded":null,"clean_sheets":null},"total":{"apps":null,"goals_conceded":null,"clean_sheets":null},"total_apps":null,"total_gc":null,"total_cs":null}],"teams":[{"team":"울산","k1":{"apps":5,"goals_conceded":5,"clean_sheets":2},"k2":{"apps":null,"goals_conceded":null,"clean_sheets":null},"po":{"apps":null,"goals_conceded":null,"clean_sheets":null},"cup":{"apps":null,"goals_conceded":null,"clean_sheets":null},"super_cup":{"apps":null,"goals_conceded":null,"clean_sheets":null},"total":{"apps":5,"goals_conceded":5,"clean_sheets":2},"total_apps":5,"total_gc":5,"total_cs":2},{"team":"서울E","k1":{"apps":null,"goals_conceded":null,"clean_sheets":null},"k2":{"apps":53,"goals_conceded":65,"clean_sheets":15},"po":{"apps":3,"goals_conceded":6,"clean_sheets":0},"cup":{"apps":null,"goals_conceded":null,"clean_sheets":null},"super_cup":{"apps":null,"goals_conceded":null,"clean_sheets":null},"total":{"apps":56,"goals_conceded":71,"clean_sheets":15},"total_apps":56,"total_gc":71,"total_cs":15}],"source":"K LEAGUE official playerDetail","fetched_at":"2026-08-29T18:03:15.707711+00:00","scout":{"profile":"문정인은(는) 울산 소속 골키퍼다. 국적 한국, 28세, 등번호 23번. 신체는 193cm, 83kg. 통산 출장 61경기, 실점 76, 클린시트 2 (클린시트 비율 3%). 공식 시즌 행은 8개이고, K리그1 5경기, K리그2 53경기. 거쳐 온 구단은 울산, 서울E이다. 2026시즌 울산에서 0경기 출장, 실점 0, 클린시트 0다. 아래 장단점은 트랜스퍼마크 식 가십이 아니라, K리그 공식 출장·득점·실점 표와 포지션·신체 스펙을 겹쳐 읽은 스카우팅이다. 출장이 적은 선수는 잠재와 역할 추정 비중이 크고, 출장이 많은 선수는 반복된 숫자로 이야기한다.","strengths":"문정인의 강점은 골문이라는 한 자리를 시즌 단위로 반복해 지킨다는 데 있다. 울산 골키퍼로 등록된 상태에서 공식 출장이 61경기다. 193cm의 키는 세트피스와 박스 안 공중볼에서 펀칭·캐치의 도달 범위를 넓힌다. 상대가 크로스를 올릴 때 수비수가 뒤로 물러나지 않아도 되는 타입이다. 출장이 어느 정도 쌓였다면, 감독이 교체 키퍼로만 쓰지 않았다는 신호다. 큰 경기 로테이션과 컵대회에서 이미 검증된 셈이다. 킥으로 빌드업에 가담할 수 있으면 수비 라인이 한 줄 높아져도 경기가 돌아간다. 반대 케이스라도, 펀칭 타이밍과 1대1 각 줄이기만 안정적이면 1순위 경쟁에서 쉽게 밀리지 않는다. 실점 후 다음 액션을 리셋하는 속도는 숫자 뒤에 숨은 강점이다.","weaknesses":"문정인을(를) 공략하는 포인트는 골키퍼 공통의 약점에서 출발한다. 높은 라인, 강한 전방 압박, 박스 밖 낮은 굴절 슈팅이다. 큰 키는 공중볼의 무기인 동시에, 낮은 근거리 슈팅에서 몸을 접는 동작이 한 박자 늦어 보일 수 있다. 컷백 이후 원터치 슈팅이 위험 구간이다. 출장 대비 실점(76/61)이 높은 편이면, 개인 선방만의 문제가 아니라 라인 높이·풀백 간격·세트피스 수비와 같이 봐야 한다. 키퍼만 탓하면 오진이다. 발밑이 흔들리면 상대는 골키퍼를 압박의 트리거로 쓴다. 펀칭 후 세컨볼, 박스 밖 캐치 미스가 약점이 되기 쉽다. 크로스 판단이 과감할수록 빈 골문 리스크도 같이 커진다. 약점은 ‘못 막는다’가 아니라, 상대가 어디에 공을 떨어뜨릴지 아는 것이다."}}