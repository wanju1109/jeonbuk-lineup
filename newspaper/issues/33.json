       "value": null
      },
      {
       "tag": "보도",
       "title": "전북 U15·U12 도 대회 결승 진출",
       "text": "U15 3연패, U12 7연패 도전. U18은 4강",
       "source_name": "국제뉴스 11월 23일",
       "source_url": "https://www.gukjenews.com/news/articleView.html?idxno=3760763",
       "label": null,
       "date": null,
       "state": null,
       "value": null
      },
      {
       "tag": "보도",
       "title": "29일 울산 원정 오후 2시",
       "text": "울산문수축구경기장. 울산 구단 홈페이지 일정",
       "source_name": "울산 HD 홈페이지",
